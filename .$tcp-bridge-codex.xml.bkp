          <mxGeometry x="70" y="270" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="g5" value="Per endpoint connectionLoop goroutine&#xa;- reconnect ticker&#xa;- handshake&#xa;- launches readLoop / pingLoop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="350" y="270" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="g6" value="Per ready TCP connection readLoop goroutine&#xa;- reads bytes&#xa;- deserializes Frame&#xa;- invokes callbacks inline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="640" y="270" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="g7" value="Per ready TCP connection pingLoop goroutine&#xa;- optional if ping_interval &gt; 0&#xa;- idle timeout / reconnect trigger" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="350" y="430" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="g8" value="tcp.Reader readerLoop goroutine&#xa;- lifecycle only&#xa;- waits for ctx.Done()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="70" y="430" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g9" value="NATS callback execution context&#xa;- QueueSubscribe callback&#xa;- Subscriber.handleMessage()&#xa;- HandleExternalRequest()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b8def" vertex="1" parent="1">
          <mxGeometry x="70" y="610" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="g10" value="workerLoop goroutines: nats_to_tcp&#xa;- count = internal.worker_count&#xa;- blocks on natsToTCPJobs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b8def" vertex="1" parent="1">
