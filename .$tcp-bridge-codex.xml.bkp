        </mxCell>
        <mxCell id="b9" value="Requester.RequestWithTimeoutToSubject(subject, frame.Payload, external.timeout)&#xa;- NATS gets payload only&#xa;- waits for []byte response" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366" vertex="1" parent="1">
