        <mxCell id="d_title" value="goroutine/channel oriented data structures" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="d_handler" value="worker.NATSInboundHandler&#xa;- ctx, cancel&#xa;- natsToTCPJobs chan *nats.Msg&#xa;- tcpToNATSJobs chan *config.Frame&#xa;- deps: natsClient, tcpSender, inflightMgr, connMgr" style="swimlane;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#5b8def;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="390" height="170" as="geometry" />
        </mxCell>
        <mxCell id="d_pool" value="config.MessageHandlerPoolConfig&#xa;Internal: worker_count, queue_size, retry_attempts, retry_delay, response_timeout&#xa;External: worker_count, queue_size, timeout" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="500" y="90" width="400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="d_frame" value="config.Frame&#xa;- Type uint8&#xa;- TID uint32&#xa;- Payload []byte&#xa;- ConnectionID string (runtime)&#xa;Methods: Serialize, IsRequest, IsResponse, GetResponseType" style="swimlane;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="320" width="360" height="170" as="geometry" />
        </mxCell>
        <mxCell id="d_ia" value="inflight.InflightEntryA&#xa;- ReplySubject string&#xa;- Payload []byte&#xa;- Attempt int&#xa;- Deadline int64&#xa;- Phase string&#xa;- ConnectionID string&#xa;- ResponseChan chan *Frame&#xa;- TimeoutChan chan struct{}&#xa;map key: tid" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="470" y="320" width="360" height="240" as="geometry" />
        </mxCell>
        <mxCell id="d_ib" value="inflight.InflightEntryB&#xa;- TID uint32&#xa;- TCPReplyInfo *TCPReplyInfo&#xa;- Payload []byte&#xa;- Deadline int64&#xa;- ResponseChan chan []byte&#xa;- TimeoutChan chan struct{}&#xa;map key: connectionID:TID" style="swimlane;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="880" y="320" width="360" height="220" as="geometry" />
        </mxCell>
        <mxCell id="d_reply" value="inflight.TCPReplyInfo&#xa;- ConnectionID string&#xa;- FrameType uint8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="1290" y="390" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d_connmgr" value="connection.ConnectionManager&#xa;- connections []*ConnMgr&#xa;- selector *PriorityConnSelector&#xa;- GetConnections() for NATS -&gt; TCP retry loop&#xa;- Write / WriteToConnection" style="swimlane;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="590" width="400" height="170" as="geometry" />
        </mxCell>
        <mxCell id="d_nats" value="internal/nats layer&#xa;- Subscriber&#xa;- ReplyPublisher&#xa;- Requester&#xa;- shared *nats.Conn" style="swimlane;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="520" y="610" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="d_tid" value="global TID state&#xa;- globalTIDCounter uint32&#xa;- lastResetDate int32&#xa;- atomic daily reset + overflow guard" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="870" y="610" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="d_note" value="Current implementation detail&#xa;InflightB is registered/removed for lifecycle tracking, but RequestWithTimeoutToSubject() returns synchronously, so ResponseChan is not the active rendezvous path in processTCPRequest()." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00" vertex="1" parent="1">
          <mxGeometry x="1220" y="610" width="500" height="130" as="geometry" />
        </mxCell>
