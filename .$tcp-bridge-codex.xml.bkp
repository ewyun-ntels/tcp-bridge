        <mxCell id="title" value="tcp-bridge runtime flow (synced to current source)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lane_a" value="A. NATS -&gt; TCP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#5b8def;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="880" height="860" as="geometry" />
        </mxCell>
        <mxCell id="lane_b" value="B. TCP -&gt; NATS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7e6;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="960" y="80" width="900" height="860" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="nats.Conn&#xa;QueueSubscribe(external_req_subject, &quot;tcp-bridge-workers&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b8def" vertex="1" parent="1">
          <mxGeometry x="70" y="130" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="Subscriber.handleMessage(msg)&#xa;- logs subject/reply/size&#xa;- invokes nh.HandleExternalRequest(msg)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b8def" vertex="1" parent="1">
          <mxGeometry x="370" y="130" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="NATSInboundHandler.HandleExternalRequest(msg)&#xa;- enqueueNATSToTCP(msg)&#xa;- if full: replyError(msg, json error)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b8def" vertex="1" parent="1">
          <mxGeometry x="670" y="130" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="chan *nats.Msg&#xa;natsToTCPJobs&#xa;buffer = internal.queue_size" style="shape=process;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="330" y="280" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="worker goroutines&#xa;startWorkers(nats_to_tcp, internal.worker_count)&#xa;workerLoop() reads natsToTCPJobs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b8def" vertex="1" parent="1">
          <mxGeometry x="330" y="420" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="processExternalRequest(msg)&#xa;1. generateTID()&#xa;2. determineMessageType(payload, subject)&#xa;3. build config.Frame{Type,TID,Payload}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b8def" vertex="1" parent="1">
          <mxGeometry x="80" y="560" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="RPC only: InflightA.Register(tid, reply, payload, deadline, phase=&quot;P&quot;)&#xa;entry has ResponseChan chan *Frame" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1">
          <mxGeometry x="390" y="560" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a8" value="sendAndWaitWithRetry(frame, inflightEntry, isRPC)&#xa;- connMgr.GetConnections()&#xa;- READY check by priority&#xa;- per-priority retryAttempts loop&#xa;- conn.Write(serialized frame)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b8def" vertex="1" parent="1">
          <mxGeometry x="80" y="720" width="290" height="120" as="geometry" />
        </mxCell>
        <mxCell id="a9" value="wait on inflightEntry.ResponseChan or time.After(response_timeout)&#xa;- success: ReplyPublisher.PublishReply(replySubject, response.Payload)&#xa;- timeout: retry&#xa;- all fail: InflightA.Remove + replyError" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="420" y="720" width="420" height="120" as="geometry" />
        </mxCell>
        <mxCell id="a10" value="TCP response path back into A&#xa;App.handleTCPResponse(frame)&#xa;- inflightMgr.GetInflightA().HandleResponse(frame)&#xa;- matched ResponseChan &lt;- frame" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1">
          <mxGeometry x="590" y="860" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="ConnMgr.readLoop()&#xa;- reads business frame&#xa;- sets frame.ConnectionID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="990" y="130" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="tcp.Reader.handleFrame(frame)&#xa;- request: onRequestFrame(frame)&#xa;- response: onResponseFrame(frame)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="1270" y="130" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="TCPInboundHandler.DispatchRequestFrame(frame)&#xa;- validates IsRequest()&#xa;- calls nh.HandleTCPRequest(frame)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="1550" y="130" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="NATSInboundHandler.HandleTCPRequest(frame)&#xa;- enqueueTCPToNATS(frame)&#xa;- if full: sendTCPErrorResponseToConnection(...)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="1270" y="280" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="chan *config.Frame&#xa;tcpToNATSJobs&#xa;buffer = external.queue_size" style="shape=process;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="960" y="290" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b6" value="worker goroutines&#xa;startWorkers(tcp_to_nats, external.worker_count)&#xa;workerLoop() reads tcpToNATSJobs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="960" y="420" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="b7" value="processTCPRequest(frame)&#xa;1. subject := GetSubjectForMessageType(frame.Type)&#xa;2. responseType := GetResponseType(frame.Type)&#xa;3. deadline := now + external.timeout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="960" y="560" width="290" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b8" value="InflightB.Register(frame.TID, TCPReplyInfo{ConnectionID, FrameType}, frame.Payload, deadline)&#xa;key = connectionID:TID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1">
